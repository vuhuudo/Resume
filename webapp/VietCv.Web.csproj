<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VietCv</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\templates\*.html" Link="templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\content\bank.json" Link="content\bank.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\fonts\*" Link="assets\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
